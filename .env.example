# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/razor

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI Recommendations (Groq API)
GROQ_API_KEY=your_groq_api_key
AI_MODE=mock

# JWT Secret
JWT_SECRET=your_jwt_secret

# Resend Email Delivery Architecture
# Modes: mock (suppress network calls for testing) | live (deliver to real customer email via Resend API)
EMAIL_DELIVERY_MODE=mock
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=nemat@razorshop.app

# Background Scheduler Control (false in dev/test, true only when explicitly enabled)
SCHEDULER_ENABLED=false